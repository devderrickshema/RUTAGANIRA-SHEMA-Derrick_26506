{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Tomcat (mvn tomcat7:run)",
      "type": "shell",
      "command": "mvn tomcat7:run",
      "args": [],
      "isBackground": true,
      "problemMatcher": {
        "owner": "tomcat",
        "fileLocation": ["relative","${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^\\[ERROR\\]\\s+(.*)$",
            "message": 1
          },
          {
            "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning):\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ],
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^\\[INFO\\] Scanning for projects\\.\\.\\.",
          "endsPattern": "Running war on http://localhost:8080/LoginServlet"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated"
      }
    }
  ]
}
