{
	"info": {
		"name": "RESTful API Assignment",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Products API",
			"item": [
				{
					"name": "Get All Products",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8080/api/products",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "products"]
						}
					}
				},
				{
					"name": "Get Product By ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8080/api/products/1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "products", "1"]
						}
					}
				},
				{
					"name": "Create Product",
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"New Product\",\n  \"description\": \"Product description\",\n  \"price\": 99.99,\n  \"category\": \"Electronics\",\n  \"stockQuantity\": 10,\n  \"brand\": \"Brand Name\"\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/products",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "products"]
						}
					}
				}
			]
		},
